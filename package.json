{
  "name": "sayanything",
  "productName": "Say Anything",
  "version": "0.2.0",
  "description": "Voice dictation for Windows and macOS that runs on your machine. Hold a key, talk, let go, and your words land in whatever app you're in. Nothing leaves your computer, no cloud.",
  "license": "MIT",
  "author": "LightningMarshal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LightningMarshal/sayanything.git"
  },
  "bugs": {
    "url": "https://github.com/LightningMarshal/sayanything/issues"
  },
  "homepage": "https://github.com/LightningMarshal/sayanything#readme",
  "main": "src/main/main.js",
  "desktopName": "io.github.lightningmarshal.SayAnything.desktop",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src",
    "native",
    "scripts",
    "assets",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "setup": "node scripts/setup.js",
    "prep": "node scripts/stage-bundle.js",
    "dist:dir": "npm run prep && electron-builder --dir",
    "dist": "npm run prep && electron-builder",
    "test": "node test/formatter-test.js && node test/rewrite-test.js && node test/wav-test.js && node test/vad-test.js && node test/streaming-test.js && node test/hotkey-match-test.js && node test/settings-defaults-test.js && node test/state-test.js && node test/hashes-test.js && node test/docs-drift-test.js && node test/boot-modules-test.js && node test/history-test.js && node test/ipc-handlers-test.js && node test/media-permissions-test.js && node test/renderer-security-test.js && node test/fuses-test.js && node test/whisper-server-test.js && node test/dbus-test.js && node test/portal-test.js && node test/helper-linux-test.js",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:electron": "electron test/overlay-css-check.js && electron test/settings-models-check.js && electron test/welcome-perms-check.js && electron test/pad-check.js && electron test/csp-check.js && electron test/settings-tabs-check.js",
    "test:e2e": "test/e2e-transcribe.sh",
    "test:e2e:partial": "test/partial-transcribe.sh"
  },
  "build": {
    "appId": "io.github.lightningmarshal.sayanything",
    "productName": "Say Anything",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/demo.gif",
      "!assets/social-preview.png",
      "!assets/screenshots/**",
      "native/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "build-resources/models",
        "to": "models"
      }
    ],
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": "nsis",
      "icon": "assets/SayAnything.ico",
      "artifactName": "SayAnything-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Say Anything"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/SayAnything.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Say Anything transcribes your voice on your Mac."
      },
      "notarize": true,
      "artifactName": "SayAnything-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "SayAnything-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "dir",
      "executableName": "sayanything",
      "category": "Utility",
      "description": "Hold a shortcut, talk, and your words appear where you type. Runs on your computer.",
      "desktop": {
        "Keywords": "dictation;speech;voice;transcription;whisper;speech-to-text;"
      }
    },
    "appImage": {
      "artifactName": "SayAnything-${version}-linux-${arch}.${ext}",
      "executableArgs": [
        "--ozone-platform-hint=auto"
      ]
    }
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "5.9.3"
  }
}
